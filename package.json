{
  "name": "editor-etiquetas-mp3-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Editor ID3 de archivos MP3 100% en el navegador. Edita metadatos y carátulas por lotes con privacidad total.",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-ssr",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "browser-id3-writer": "^6.4.0",
    "jsmediatags": "^3.9.7",
    "jszip": "^3.10.2",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/jsmediatags": "^3.9.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
